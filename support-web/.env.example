# Support Django API origin (no trailing slash).
# Local: http://localhost:8002
# Staging: https://staging.support.prismavalet.com
# Production: https://support.prismavalet.com
VITE_API_URL=http://localhost:8002

# WebSocket URL for crew chat (no trailing slash).
# Local: ws://localhost:8002
# Staging: wss://staging.support.prismavalet.com
# Production: wss://support.prismavalet.com
VITE_WS_URL=ws://localhost:8002

# Vite public path. Use / for local, staging desk subdomain, and production.
# VITE_BASE=/
