# Support Server Environment Variables
# Copy this file to .env and fill in the values

# Environment (development, staging, production)
PRISMA_ENV=production
DEBUG=False

# Database Configuration
# Option 1: Use DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Option 2: Use individual variables
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=host
# POSTGRES_DB=database_name
# POSTGRES_PORT=5432

# Redis (for Django Channels and Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Django Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# JWT Settings
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# Internal API Key (for detailer→support communication)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPORT_INTERNAL_API_KEY=your-secure-random-key-here

# Email Configuration (for password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@prismavalet.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=support@prismavalet.com

# Google Cloud Storage (for media files in staging/production)
GS_BUCKET_NAME=prisma_support_bucket
GS_LOCATION=support-app
# GS_CREDENTIALS_PATH=/path/to/credentials.json

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# CORS Settings
CORS_ALLOWED_ORIGINS=https://support.prismavalet.com,https://app.prismavalet.com

# Allowed Hosts
ALLOWED_HOSTS=support.prismavalet.com,localhost,127.0.0.1

# Celery (background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Channels (WebSockets)
ASGI_APPLICATION=prisma.asgi.application

# Database Connection Pooling
DATABASE_CONN_MAX_AGE=600

# Static/Media Files
STATIC_URL=/static/
MEDIA_URL=/media/

# Sentry (optional, for error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# Other API Keys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
